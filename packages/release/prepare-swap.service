[Unit]
Description=Prepare Swap
# Swap capacity is applied once per boot, never resized by a settings transaction.
# Wanted, not required, by preconfigured.target: a failure leaves the node booting
# without swap.
RefuseManualStart=true
RefuseManualStop=true
# Ordered after bootstrap commands so sizes they set apply on this boot, without
# requiring them: a failed bootstrap command doesn't remove swap.
After=settings-applier.service bootstrap-commands.service
Requires=settings-applier.service
Before=containerd.service kubelet.service

[Service]
Type=oneshot
ExecStart=/usr/bin/corndog prepare-swap
RemainAfterExit=true
StandardError=journal+console
SyslogIdentifier=prepare-swap

[Install]
WantedBy=preconfigured.target
