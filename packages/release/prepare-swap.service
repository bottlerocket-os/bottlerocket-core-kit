[Unit]
Description=Prepare Swap
RefuseManualStart=true
RefuseManualStop=true
# Run after bootstrap commands so a zram size they set applies on this boot.
After=settings-applier.service bootstrap-commands.service
Requires=settings-applier.service
Before=containerd.service kubelet.service

[Service]
Type=oneshot
ExecStart=/usr/bin/corndog prepare-swap
RemainAfterExit=true
StandardError=journal+console
SyslogIdentifier=prepare-swap

[Install]
WantedBy=preconfigured.target
