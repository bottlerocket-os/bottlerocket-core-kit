[Unit]
Description=Host container image verifier trust policy drop-ins (/etc/host-containerd/image-verifiers/digestion/trustpolicy.d)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target
After=selinux-policy-files.service
Wants=selinux-policy-files.service

[Mount]
What=tmpfs
Where=/etc/host-containerd/image-verifiers/digestion/trustpolicy.d
Type=tmpfs
Options=nosuid,nodev,noexec,noatime,mode=0700,context=system_u:object_r:secret_t:s0

[Install]
WantedBy=preconfigured.target
