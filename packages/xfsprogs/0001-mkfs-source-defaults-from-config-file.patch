From 46605e1f1d67bf2344ffab9447e763ebc13f6387 Mon Sep 17 00:00:00 2001
From: Sparks Song <shijiao@amazon.com>
Date: Thu, 14 Nov 2024 00:17:10 +0000
Subject: [PATCH] mkfs: source defaults from config file

---
 mkfs/xfs_mkfs.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/mkfs/xfs_mkfs.c b/mkfs/xfs_mkfs.c
index 6d2469c..bc76b80 100644
--- a/mkfs/xfs_mkfs.c
+++ b/mkfs/xfs_mkfs.c
@@ -14,6 +14,7 @@
 #include "libfrog/dahashselftest.h"
 #include "proto.h"
 #include <ini.h>
+#include <unistd.h>
 
 #define TERABYTES(count, blog)	((uint64_t)(count) << (40 - (blog)))
 #define GIGABYTES(count, blog)	((uint64_t)(count) << (30 - (blog)))
@@ -4369,6 +4370,21 @@ main(
 	 * printf(_("Default configuration sourced from %s\n"), dft.source);
 	 */
 
+	char *default_config_path = "/usr/share/xfs/mkfs.xfs.conf";
+	char *original_cfgfile = cli.cfgfile;  // Save the original value (from -c if specified)
+
+	// First try to load the default config if it exists
+	if (access(default_config_path, R_OK) == 0) {
+		cli.cfgfile = default_config_path;
+		cfgfile_parse(&cli);
+		printf(_("Default configuration sourced from %s\n"), default_config_path);
+	} else {
+		fprintf(stderr, _("Warning: Default config file %s not found or not readable\n"), default_config_path);
+	}
+
+	// Restore the original cfgfile value (from -c if specified)
+	cli.cfgfile = original_cfgfile;
+
 	/* copy new defaults into CLI parsing structure */
 	memcpy(&cli.sb_feat, &dft.sb_feat, sizeof(cli.sb_feat));
 	memcpy(&cli.fsx, &dft.fsx, sizeof(cli.fsx));
-- 
2.47.0

