[Unit]
Description=Copy SELinux policy files
DefaultDependencies=no
RefuseManualStart=true
RefuseManualStop=true

[Service]
Type=oneshot

# Userspace expects the SELinux policy files to be available in /etc/selinux.
# Because our /etc is a tmpfs mount, we need to copy the policy files from the
# root filesystem during startup. Ordinarily we would use a tmpfiles.d snippet
# for this, but we need to ensure that the file_contexts are available before
# tmpfiles.d runs, so that relabel directives work as expected.
#
# Copy to a temporary directory and rename it into place, so that other units
# never see a partially copied policy. libselinux treats SELinux as disabled
# until /etc/selinux/config exists, but fails to load the file contexts if the
# config is present and file_contexts is not yet.
ExecStart=/usr/bin/cp -r /usr/share/factory/etc/selinux /etc/.selinux.tmp
ExecStart=/usr/bin/mv -T /etc/.selinux.tmp /etc/selinux

RemainAfterExit=true
StandardError=journal+console

[Install]
WantedBy=local-fs.target
