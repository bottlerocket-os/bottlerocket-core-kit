[required-extensions]
std = { version = "v1" }
+++
[Service]
# Backwards-compatibility drop-in for nvidia variants that still need the legacy
# /usr/lib/nvidia/tesla library path. Overrides the clean default ExecStart to add
# `--additional-symlinks /usr/lib/nvidia/tesla`, so the generated CDI spec
# (/etc/cdi/nvidia.json) recreates the legacy library path inside containers.
# Variants that do not render this drop-in keep the clean default.
ExecStart=
ExecStart=/usr/bin/nvidia-ctk cdi generate --format json \
  --additional-symlinks /usr/lib/nvidia/tesla \
  --mode nvml \
  --device-name-strategy uuid \
  --device-name-strategy index \
  --output /etc/cdi/nvidia.json
ExecStart=/usr/bin/nvidia-ctk cdi transform root \
  --from __PREFIX__ \
  --to / \
  --relative-to container \
  --input /etc/cdi/nvidia.json \
  --output /etc/cdi/nvidia.json
