[Unit]
Description=Generate CDI specifications
# This has to be executed after the kernel modules are loaded
# otherwise the userspace component of the driver will fail to
# query the /dev devices
After=load-tesla-kernel-modules.service load-open-gpu-kernel-modules.service
# Running this unit after nvidia persistenced ensures that
# the /dev devices are created and the hardware set to
# persistence mode.
Requires=nvidia-persistenced.service
After=nvidia-persistenced.service
# Running this unit after nvidia migmanager ensures that the GPU
# is partitioned according to the settings. In Ampere GPUs, the
# device goes into transition state when MIG is enabled. In this
# case, we skip running the service, waiting for the eventual reboot.
Requires=nvidia-migmanager.service
After=nvidia-migmanager.service
ConditionPathExists=!/run/nvidia-migmanager/reboot-required
# Run after settings have been applied so that, on variants that render the
# backwards-compatibility drop-in, exec-start.conf exists before this unit
# starts. Without a drop-in (the default), the ExecStart below is used as-is.
After=settings-applier.service
# Block manual interactions with this service. It doesn't
# make sense to regenerate CDI specifications as features
# that might change the GPU (e.g. MIG) are not supported in
# ECS
RefuseManualStart=true
RefuseManualStop=true

[Service]
Type=oneshot
# Explanation of the options:
# --format json: to be consistent across Bottlerocket's variants
# --mode nvml: the default mode ("auto") resolves to this already, make it explicit
# --device-name-strategy uuid: the ECS agent only supports device UUIDs; for k8s
#                              this is irrelevant because these specs will be used
#                              only when NVIDIA_VISIBLE_DEVICES is "all"
# --output /etc/cdi/nvidia.json: store the CDI specifications at this location
#
# NOTE: This is the default (clean) ExecStart, used by EKS k8s 1.37+ nvidia
# variants. It does NOT create the legacy /usr/lib/nvidia/tesla backwards-compat
# symlinks. Variants for k8s 1.36 and below render a drop-in from the
# generate-cdi-specs-exec-start-conf-compat template that overrides this
# ExecStart to add `--additional-symlinks /usr/lib/nvidia/tesla`.
ExecStart=/usr/bin/nvidia-ctk cdi generate --format json \
  --mode nvml \
  --device-name-strategy uuid \
  --output /etc/cdi/nvidia.json
RemainAfterExit=true
StandardError=journal+console

[Install]
RequiredBy=preconfigured.target
