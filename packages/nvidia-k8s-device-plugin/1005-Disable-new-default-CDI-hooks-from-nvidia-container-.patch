From dce4a2a0a45e563a7c43c27507e40636ad848a91 Mon Sep 17 00:00:00 2001
From: Cezar Rata <ceradev@amazon.com>
Date: Fri, 30 Oct 2026 23:29:08 +0000
Subject: [PATCH] Disable new default CDI hooks from nvidia-container-toolkit
 v1.20

nvidia-container-toolkit v1.20 adds two CDI hooks that are enabled by
default and would be included in the CDI specifications generated by
the device plugin:

- update-application-profile writes a driver application profile into
  the container that restricts EGL/Vulkan GPU visibility to the GPUs
  mounted in the container.
- apply-cuda-memory-limits is added to every full-GPU device and runs as
  a createRuntime hook in the host namespace, setting CUDA memory limits
  from the NVIDIA_GPU_MEMORY_REQUEST/LIMIT container environment
  variables.

Keep both disabled until they have been evaluated for Bottlerocket.

v0.20 also adds a --cdi-disable-hooks flag (CDI_DISABLE_HOOKS), but it
is a command line option rather than a config file setting. Disabling
the hooks here, as is already done for enable-cuda-compat, keeps them
off regardless of which exec-start template (default or -compat) a
variant renders, without passing the flag in each template.

Signed-off-by: Cezar Rata <ceradev@amazon.com>
---
 internal/cdi/cdi.go | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/internal/cdi/cdi.go b/internal/cdi/cdi.go
index fd1c7fe5e..d5dab481b 100644
--- a/internal/cdi/cdi.go
+++ b/internal/cdi/cdi.go
@@ -143,6 +143,10 @@ func New(infolib info.Interface, nvmllib nvml.Interface, devicelib device.Interf
 		nvcdi.WithNvmlLib(c.nvmllib),
 		nvcdi.WithVendor(c.vendor),
 		nvcdi.WithDisabledHook(nvcdi.EnableCudaCompatHook),
+		// Hooks added in nvidia-container-toolkit v1.20 that are enabled by default.
+		// Keep the generated CDI specs limited to the hooks Bottlerocket expects.
+		nvcdi.WithDisabledHook("update-application-profile"),
+		nvcdi.WithDisabledHook("apply-cuda-memory-limits"),
 		nvcdi.WithEnabledHooks(c.nvcdiEnabledHooks...),
 	}
 
