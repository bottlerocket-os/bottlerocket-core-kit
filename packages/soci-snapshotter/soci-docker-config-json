[required-extensions]
container-registry = "v1"
+++
{
  "auths": {
    {{~#if settings.container-registry.credentials~}}
    {{~#each settings.container-registry.credentials~}}
    {{~#unless @first~}},{{~/unless~}}
    {{~#if (eq registry "docker.io" )}}
    "https://index.docker.io/v1/": {
    {{~else}}
    "{{registry}}": {
    {{~/if~}}
    {{~#if username~}}
      "username": "{{{username}}}"
      {{~#if password}}, "password": "{{{password}}}"{{/if~}}
      {{~#if auth}}, "auth": "{{{auth}}}"{{/if~}}
      {{~#if identitytoken}}, "identitytoken": "{{{identitytoken}}}"{{/if~}}
    {{~else~}}{{~#if password~}}
      "password": "{{{password}}}"
      {{~#if auth}}, "auth": "{{{auth}}}"{{/if~}}
      {{~#if identitytoken}}, "identitytoken": "{{{identitytoken}}}"{{/if~}}
    {{~else~}}{{~#if auth~}}
      "auth": "{{{auth}}}"
      {{~#if identitytoken}}, "identitytoken": "{{{identitytoken}}}"{{/if~}}
    {{~else~}}{{~#if identitytoken~}}
      "identitytoken": "{{{identitytoken}}}"
    {{~/if~}}{{~/if~}}{{~/if~}}{{~/if~}}
    }
    {{~/each~}}
    {{~/if}}
  }
}
