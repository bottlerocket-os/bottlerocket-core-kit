[required-extensions]
ntp = "v1"
std = { version = "v1", helpers = ["is_array"] }
+++
{{#if (is_array settings.ntp.time-servers)}}
{{#each settings.ntp.time-servers}}
pool {{this}}{{#each ../settings.ntp.options}} {{this}}{{/each}}
{{/each}}
{{else}}
{{#each settings.ntp.time-servers}}
{{#if this.address}}
{{#if this.directive}}{{this.directive}}{{else}}server{{/if}} {{this.address}}{{#if this.options}}{{#each this.options}} {{this}}{{/each}}{{/if}}
{{/if}}
{{/each}}
{{/if}}
driftfile /var/lib/chrony/drift
makestep 1.0 3
dumponexit
dumpdir /var/lib/chrony
logdir /var/log/chrony
{{#if settings.ntp.logging}}
log{{#each settings.ntp.logging}} {{this}}{{/each}}
{{/if}}
user chrony
rtcsync
